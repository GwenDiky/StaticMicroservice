import logging

import uvicorn
from fastapi import FastAPI

from src.api.handlers.statics import statics_router
from src.core.config import setup_logging
from src.core.consumer import start_listen
from src.models.core_static import get_mongo_client

logger = logging.getLogger(__name__)

app = FastAPI()
app.include_router(statics_router, prefix="/static", tags=["static"])


@app.on_event("startup")
async def startup_event():
    client = get_mongo_client()
    logger.info("бла бла бла сраный стартап запущен")
    await start_listen(client)


if __name__ == "__main__":
    setup_logging()
    uvicorn.run("main:app", reload=True, port=8084)
